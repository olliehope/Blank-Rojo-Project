{
  "name": "Blank-Rojo-Project",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Services": {
        "$className": "Folder",
        "ExampleService": {
          "$className": "Folder",
          "ExampleServiceClient": {
            "$path": "src/services/ExampleService/Client"
          },
          "ExampleServiceUtils": {
            "$path": "src/services/ExampleService/Utils"
          }
        }
      },
      "Packages": {
        "$className": "Folder"
      }
    },
    "ServerScriptService": {
      "Services": {
        "$className": "Folder",
        "ExampleService": {
          "$className": "Folder",
          "ExampleServiceServer": {
            "$path": "src/services/ExampleService/Server"
          }
        }
      },
      "Server": {
        "$path": "src/startup/Server.server.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "UI": {
          "$className": "Folder",
          "App": {
            "$path": "src/ui/App.luau"
          },
          "Components": {
            "$className": "Folder",
            "Text": {
              "$path": "src/ui/components/Text.luau"
            }
          },
          "Renderer": {
            "$path": "src/ui/Renderer.luau"
          },
          "Screens": {
            "$className": "Folder",
            "Screen": {
              "$path": "src/ui/screens/Screen.luau"
            }
          },
          "Theme": {
            "$className": "Folder",
            "Theme": {
              "$path": "src/ui/theme/Theme.luau"
            }
          }
        },
        "Client": {
          "$path": "src/startup/Client.client.luau"
        }
      }
    }
  }
}
